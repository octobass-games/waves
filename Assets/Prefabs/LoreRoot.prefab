      m_Calls: []
  m_text: "Dear Hronn,\r\nI\u2019m writing from the grand hot springs, although not
    currently sitting in them\u2026 that would be impractical! They\u2019re very
    beautiful and relaxing, I really wish you could be here!\n\r\nI will travel back
    at the end of the month and will visit you as soon as I arrive!\r\nI have many
    presents, but wont spoil the surprise!\r\nYours,\r\nTerra\r\n"
  m_isRightToLeft: 0
